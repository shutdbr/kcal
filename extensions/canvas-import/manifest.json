{
  "manifest_version": 3,
  "name": "kcal · Import from Krea Canvas",
  "version": "0.2.1",
  "description": "Bring the courses on your Krea Canvas Courses page into kcal, with a preview before changing your plan.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Import Canvas courses into kcal",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-import@kcal.local",
      "strict_min_version": "109.0"
    }
  }
}
