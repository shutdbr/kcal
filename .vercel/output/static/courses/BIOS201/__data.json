{"type":"data","nodes":[null,null,{"type":"data","data":[{"code":1,"requestedAs":1,"title":2,"credits":3,"creditsPending":4,"subject":5,"listings":6,"offered":9,"eligibleYears":11,"description":14,"prerequisites":15,"unlocks":25,"equivalents":62,"lecturers":63,"terms":68,"programmes":71,"batches":84},"BIOS201","Life at Different Scales",4,false,"biology",[7],{"subject":5,"href":8,"code":1},"/programmes/biology",[10],1,[12,13,3],2,3,"Based upon selected case studies, this course covers notions of scale from building blocks of life to biomes, organisational levels and integration of biological units, and the primacy of description. We start with Aristotelian classification and proceed through Early Modern natural philosophy and natural history to the discipline of biology itself in the present day. We consider the development of particular philosophies and forms of technology from the 17th to 19th centuries and corresponding development of elements of biology at different points in time, including such concepts as biogeography, ecology, evolution, cell biology, genetics, anatomy, and physiology, even as theological holds over the subject begin to waver.",[16,19,22],{"code":17,"title":18,"credits":13},"KCCS102","Mathematical Reasoning",{"code":20,"title":21,"credits":13},"KCCS121","Scientific Reasoning",{"code":23,"title":24,"credits":13},"KCCS124","Data Analytics",[26,29,32,35,38,41,44,47,50,53,56,59],{"code":27,"title":28,"credits":3},"BIOS235","Animal Behaviour",{"code":30,"title":31,"credits":3},"BIOS218","Biochemistry",{"code":33,"title":34,"credits":3},"BIOS224","Evolution",{"code":36,"title":37,"credits":3},"BIOS226","Form and Function",{"code":39,"title":40,"credits":3},"BIOS221","Genetics",{"code":42,"title":43,"credits":3},"BIOS236","Immunology",{"code":45,"title":46,"credits":3},"BIOS307","Introduction to Bioinformatics",{"code":48,"title":49,"credits":12},"BIOS207","LAB I",{"code":51,"title":52,"credits":3},"BIOS217","Microbiology",{"code":54,"title":55,"cr