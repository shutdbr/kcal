{"type":"data","nodes":[null,null,{"type":"data","data":[{"code":1,"requestedAs":1,"title":2,"credits":3,"creditsPending":4,"subject":5,"listings":6,"offered":9,"eligibleYears":11,"description":14,"prerequisites":15,"unlocks":16,"equivalents":32,"lecturers":39,"terms":44,"programmes":47,"batches":61},"COMP201","Discrete Mathematics",4,false,"computer science",[7],{"subject":5,"href":8,"code":1},"/programmes/computer-science",[10],1,[12,13,3],2,3,"Discrete Mathematics course will provide students with their first glimpse of how to think rigorously about discrete and finite phenomena. The course will begin by introducing students to the language and grammar of mathematics. It will then proceed to an axiomatic construction of the natural numbers, and introduce the fundamental mathematical notions of sets, relations, and functions. The remainder of the course will be organized around three distinct modules: number theory, permutations and counting, and graph theory.",[],[17,20,23,26,29],{"code":18,"title":19,"credits":3},"BIOS307","Introduction to Bioinformatics",{"code":21,"title":22,"credits":3},"COMP208","Introduction to Linear Algebra",{"code":24,"title":25,"credits":3},"COMP330","Logic",{"code":27,"title":28,"credits":3},"COMP321","Models of Computation",{"code":30,"title":31,"credits":3},"COMP340","Security: Technology, Privacy and Ethics",[33,36],{"code":34,"title":35,"credits":3},"MATH191","Proofs and Ideas: An Introduction to Mathematical Thinking",{"code":37,"title":38,"credits":3},"DATA203","Mathematical Foundations of Data Science",[40],{"id":41,"name":42,"title":43},"prathamesh-t-v-h","Prathamesh T V H","Assistant Professor, Computer Science",[45,46],"2026 T1","2024 T1",[48],{"subject":5,"slug":49,"required":50,"choice":59,"elective":60},"computer-science",[51,52,53,54,55,56,57,58],"4-year major","4-year double major","3-year major","3-year double major","4-year minor","3-year minor","concentration (4-year)","concentration (3-year)",[],[],"2024–2026"],"uses